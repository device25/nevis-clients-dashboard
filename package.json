{
  "name": "nevis-clients-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "check": "pnpm dedupe --check && tsc -b && eslint . && prettier --check . && vitest run",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter api start",
    "test:e2e": "pnpm build && playwright test --config apps/web/playwright.config.ts",
    "verify:compiler": "node scripts/verify-compiler.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "axe-core": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
